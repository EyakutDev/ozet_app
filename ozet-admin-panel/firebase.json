{
    "hosting":  {
                    "target":  "admin-paneli",
                    "public":  "public",
                    "ignore":  [
                                   "firebase.json",
                                   "**/.*",
                                   "**/node_modules/**",
                                   "**/.idea/**"
                               ],
                    "headers":  [
                                    {
                                        "source":  "**",
                                        "headers":  [
                                                        {
                                                            "key":  "Cache-Control",
                                                            "value":  "no-cache, no-store, must-revalidate"
                                                        }
                                                    ]
                                    }
                                ]
                },
    "functions":  {
                      "source":  "functions",
                      "runtime":  "nodejs22",
                      "ignore":  [
                                     "node_modules",
                                     ".git",
                                     "firebase-debug.log",
                                     "firebase-debug.*.log"
                                 ]
                  },
    "firestore":  {
                      "rules":  "firestore.rules"
                  },
    "emulators":  {
                      "firestore":  {
                                        "port":  8181
                                    },
                      "ui":  {
                                 "enabled":  false
                             },
                      "singleProjectMode":  true
                  }
}